<h1>Producers</h1>
<p class="lede">Browse producers and their associated wines.</p>
<div class="page-actions">
  <% if user_signed_in? %>
    <%= link_to "+ New Producer", new_producer_path, class: "btn" %>
  <% end %>
</div>
<% if @producers.any? %>
  <%= render "producers/producers_table", producers: @producers, show_actions: user_signed_in? %>
<% else %>
  <p class="empty">No producers have been added yet.</p>
<% end %>
