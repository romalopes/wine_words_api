<h1>Producers</h1>
<p class="lede">Browse producers and their associated wines.</p>
<% if user_signed_in? %>
  <div class="page-actions">
    <%= link_to "+ New Producer", new_producer_path, class: "btn" %>
  </div>
<% end %>
<% if @producers.any? %>
  <section class="producer-grid" aria-label="Producers">
    <% @producers.each do |producer| %>
      <div class="card-wrapper">
        <% if user_signed_in? %>
        <div class="card-actions">
          <%= link_to "Edit", edit_producer_path(producer.slug), class: "card-action" %>
          <%= button_to "Delete", producer_path(producer.slug), method: :delete, form_class: "card-delete-form", class: "card-action card-action--delete", onclick: %(return confirm('Delete this item? This action cannot be undone.')) %>
        </div>
        <% end %>
        <%= link_to producer_path(producer.slug), class: "producer-card #{producer_color_class(producer)}" do %>
        <% if producer.images.attached? %>
          <%= image_tag url_for(producer.images.first), class: "card-thumb", alt: producer.name %>
        <% end %>
        <div class="producer-card__band"></div>
        <div class="producer-card__content">
          <h2><%= producer.name %></h2>
          <% if producer_details(producer).present? %>
            <p class="details"><%= producer_details(producer) %></p>
          <% end %>
          <div class="wines">
            <%= pluralize(producer.wines.size, "wine") %>
          </div>
        </div>
      <% end %>
      </div>
    <% end %>
  </section>
<% else %>
  <p class="empty">No producers have been added yet.</p>
<% end %>

