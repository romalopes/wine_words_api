<%= form_with model: vintage, local: true do |f| %>
  <div>
    <%= f.label :year %><br>
    <%= f.number_field :year, min: 1900 %>
  </div>
  <div>
    <%= f.label :prompt %><br>
    <%= f.text_area :prompt %>
  </div>
  <div>
    <%= f.label :wine_id %><br>
    <%= f.collection_select :wine_id, Wine.order(:name), :id, :name, include_blank: true %>
  </div>
  <div><%= f.submit %></div>
<% end %>