<%= form_with model: vintage, local: true do |f| %>
  <div>
    <%= f.label :year %><br>
    <%= f.number_field :year, min: 1900 %>
  </div>
  <div>
    <%= f.label :price %><br>
    <%= f.number_field :price, min: 0, step: 0.01 %>
  </div>
  <div>
    <%= f.check_box :no_vintage %>
    <%= f.label :no_vintage, "No vintage (NV)" %>
  </div>
  <div>
    <%= f.label :prompt %><br>
    <%= f.text_area :prompt %>
  </div>
  <div>
    <%= f.label :wine_id %><br>
    <%= f.collection_select :wine_id, Wine.order(:name), :id, :name, include_blank: true, selected: f.object.wine_id %>
  </div>
  <div><%= f.submit class: "btn" %></div>
<% end %>