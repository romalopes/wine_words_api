<h1>Wine Taste Parameters</h1>
<p class="lede">Browse wine taste parameter assignments.</p>
<% if @wine_taste_parameters.any? %>
  <section class="wine-taste-parameter-grid" aria-label="Wine taste parameters">
    <% @wine_taste_parameters.each do |wtp| %>
      <%= link_to wine_taste_parameter_path(wtp), class: "wine-taste-parameter-card #{wine_taste_parameter_score_class(wtp)}" do %>
        <div class="wine-taste-parameter-card__band"></div>
        <div class="wine-taste-parameter-card__content">
          <h2><%= wtp.wine&.name %></h2>
          <p class="meta"><%= wine_taste_parameter_label(wtp) %></p>
          <p class="details">Score: <%= wtp.score %></p>
        </div>
      <% end %>
    <% end %>
  </section>
<% else %>
  <p class="empty">No wine taste parameters have been added yet.</p>
<% end %>