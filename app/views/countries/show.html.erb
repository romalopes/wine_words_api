<h1><%= @country.flag_emoji %> <%= @country.name %></h1>
<%= back_to_source_link %>
<ul class="facts" aria-label="Country details">
  <li><strong>ISO code:</strong> <%= @country.code.upcase %></li>
  <li><strong>Continent:</strong> <%= @country.continent || "—" %></li>
  <li><strong>Wine country:</strong> <%= @country.is_wine_country ? "Yes" : "No" %></li>
  <li><strong>Grapes:</strong> <%= @country.grapes.any? ? @country.grapes.order(:name).map(&:name).join(", ") : "—" %></li>
</ul>

<section id="producers" class="wine-detail__section">
  <h2>Producers (<%= @producer_count %>)</h2>
  <% if @producers.any? %>
  <%= render "producers/producers_table", producers: @producers, show_actions: user_signed_in? %>
  <%= render "shared/pagination", page: @producer_page, total_pages: @producer_total_pages, param_name: :producer_page, anchor: "producers" %>
<% else %>
  <p class="empty">No producers for this country yet.</p>
<% end %>
</section>

<section id="wines" class="wine-detail__section">
  <h2>Wines (<%= @wine_count %>)</h2>
  <% if @wines.any? %>
    <%= render "wines/wine_table", wines: @wines %>
    <%= render "shared/pagination", page: @wine_page, total_pages: @wine_total_pages, param_name: :wine_page, anchor: "wines" %>
  <% else %>
    <p class="empty">No wines for this country yet.</p>
  <% end %>
</section>

<% if current_user&.super_admin? || current_user&.editor? %>
  <div class="page-actions">
    <%= link_to "Edit Country", edit_country_path(@country), class: "btn btn--secondary" %>
    <%= button_to "Delete Country", country_path(@country), method: :delete, class: "btn", onclick: %(return confirm('Delete this country?')) %>
  </div>
<% end %>
<%= link_to "← All countries", countries_path, class: "back-link" %>
