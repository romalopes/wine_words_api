<h1><%= @country.flag_emoji %> <%= @country.name %></h1>
<ul class="facts" aria-label="Country details">
  <li><strong>ISO code:</strong> <%= @country.code.upcase %></li>
  <li><strong>Continent:</strong> <%= @country.continent || "—" %></li>
  <li><strong>Wine country:</strong> <%= @country.is_wine_country ? "Yes" : "No" %></li>
  <li><strong>Grapes:</strong> <%= @country.grapes.any? ? @country.grapes.order(:name).map(&:name).join(", ") : "—" %></li>
</ul>

<section id="producers" class="wine-detail__section">
  <h2>Producers</h2>
  <% if @producers.any? %>
    <table class="grapes-table producers-table">
      <thead>
        <tr>
          <th class="producers-table__image-col">Image</th>
          <th>Name</th>
          <th>Type</th>
          <th>Wines</th>
        </tr>
      </thead>
      <tbody>
        <% @producers.each_with_index do |producer, index| %>
          <tr class="<%= index.even? ? "grapes-row--even" : "grapes-row--odd" %>">
            <td>
              <% if producer.logo.attached? %>
                <%= image_tag url_for(producer.logo), class: "producers-table__thumb", alt: producer.name %>
              <% else %>
                <span class="producers-table__thumb producers-table__thumb--empty" aria-hidden="true"></span>
              <% end %>
            </td>
            <td><%= link_to producer.name, producer_path(producer.slug), class: "grapes-table__link" %></td>
            <td><%= producer.producer_type&.titleize.presence || "—" %></td>
            <td><%= link_to pluralize(producer.wines.size, "wine"), wines_path(producer: producer.slug), class: "grapes-table__link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">No producers for this country yet.</p>
  <% end %>
</section>

<section id="wines" class="wine-detail__section">
  <h2>Wines</h2>
  <% if @wines.any? %>
    <%= render "wines/wine_table", wines: @wines %>
  <% else %>
    <p class="empty">No wines for this country yet.</p>
  <% end %>
</section>

<% if current_user&.super_admin? || current_user&.editor? %>
  <div class="page-actions">
    <%= link_to "Edit Country", edit_country_path(@country.id), class: "btn btn--secondary" %>
    <%= button_to "Delete Country", country_path(@country.id), method: :delete, class: "btn", onclick: %(return confirm('Delete this country?')) %>
  </div>
<% end %>
<%= link_to "← All countries", countries_path, class: "back-link" %>
