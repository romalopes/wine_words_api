<h1>Countries</h1>
<label class="region-tree-filter">
  <input type="checkbox" id="only-wine-countries" checked />
  <span>Only show wine countries</span>
</label>
<div class="page-actions">
  <% if current_user&.super_admin? || current_user&.editor? %>
    <%= link_to "+ New Country", new_country_path, class: "btn" %>
  <% end %>
</div>
<% if @countries.any? %>
  <table class="grapes-table">
    <thead>
      <tr>
        <th>Flag</th>
        <th>Name</th>
        <th>Code</th>
        <th>Continent</th>
        <th>Producers</th>
        <th>Wines</th>
        <% if current_user&.wine_manager? %>
          <th>Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @countries.each_with_index do |country, index| %>
        <tr class="<%= index % 2 == 0 ? "grapes-row--even" : "grapes-row--odd" %>" data-wine-country="<%= country.is_wine_country %>">
          <td><%= country.flag_emoji %></td>
          <td><%= link_to country.name, country_path(country) %></td>
          <td><%= country.code.upcase %></td>
          <td><%= country.continent || "—" %></td>
          <td>
            <% count = @producer_counts[country.id] || 0 %>
            <% if count > 0 %>
              <%= link_to "#{count} producer#{count == 1 ? '' : 's'}", country_path(country, anchor: "producers"), class: "grapes-table__link" %>
            <% else %>
              —
            <% end %>
          </td>
          <td>
            <% count = @wine_counts[country.id] || 0 %>
            <% if count > 0 %>
              <%= link_to "#{count} wine#{count == 1 ? '' : 's'}", country_path(country, anchor: "wines"), class: "grapes-table__link" %>
            <% else %>
              —
            <% end %>
          </td>
          <% if current_user&.wine_manager? %>
            <td class="actions">
              <%= link_to "Show", country_path(country), class: "card-action" %>
              <%= link_to "Edit", edit_country_path(country), class: "card-action" %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No countries have been added yet.</p>
<% end %>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var checkbox = document.getElementById("only-wine-countries");
    if (!checkbox) return;
    function applyFilter() {
      var rows = document.querySelectorAll("tr[data-wine-country]");
      rows.forEach(function (row) {
        var isWine = row.dataset.wineCountry === "true";
        row.style.display = (checkbox.checked && !isWine) ? "none" : "";
      });
    }
    checkbox.addEventListener("change", applyFilter);
    applyFilter();
  });
</script>
