<% content_for :title, "#{@wine.name} · Wine Library" %>
<article class="wine-page">
  <%= link_to "← All wines", wines_path, class: "back-link" %>
  <h1><%= @wine.name %></h1>
  <p class="lede">
    <% if @wine.producer.present? %><%= link_to @wine.producer.name, producer_path(@wine.producer.slug), class: "text-link" %> · <% end %><%= @wine.color %><%= " · " %><strong><% if @wine.categories.any? %><%= @wine.categories.map { |c| link_to c.name, category_path(c.id), class: "text-link" }.join(", ").html_safe %><% else %>Uncategorised<% end %></strong>
  </p>
  <% if can_manage_wines? %>
    <div class="page-actions">
      <%= link_to "Edit Wine", edit_wine_path(@wine.slug), class: "btn btn--secondary" %>
      <%= button_to "Delete Wine", wine_path(@wine.slug), method: :delete, class: "btn", onclick: %(return confirm('Delete this item? This action cannot be undone.')) %>
    </div>
  <% end %>
  <% if @wine.images.attached? %>
    <div class="image-gallery">
      <% @wine.images.each do |image| %>
        <%= image_tag url_for(image), class: "gallery-img", alt: @wine.name %>
      <% end %>
    </div>
  <% end %>
  <ul class="facts" aria-label="Wine details">
    <% if @wine.alcohol_percentage.present? %>
      <li><strong>Alcohol:</strong> <%= @wine.alcohol_percentage %>% ABV</li>
    <% end %>
    <% if @wine.volume_ml.present? %>
      <li><strong>Volume:</strong> <%= @wine.volume_label %></li>
    <% end %>
    <% if @wine.color.present? %>
      <li><strong>Colour:</strong> <%= @wine.color %></li>
    <% end %>
    <% if @wine.closure.present? %>
      <li><strong>Closure:</strong> <%= @wine.closure %></li>
    <% end %>
    <% if @wine.sparkling? %>
      <li><strong>Style:</strong> Sparkling ✨</li>
    <% end %>
    <% if @wine.grapes.any? %>
      <li><strong>Grapes:</strong> <%= @wine.grapes.order(:name).map(&:name).join(", ") %></li>
    <% end %>
    <% if @wine.regions.any? %>
      <li><strong>Regions:</strong> <%= @wine.regions.map(&:name).join(", ") %></li>
    <% end %>
  </ul>
  <% if @wine.prompt.present? %>
    <p class="prompt"><%= @wine.prompt %></p>
  <% end %>
  <% if @wine.wine_taste_parameters.any? %>
    <h2>Taste Parameters</h2>
    <ul class="facts" aria-label="Taste parameters">
      <% @wine.wine_taste_parameters.includes(:taste_parameter).order("taste_parameters.label").each do |wtp| %>
        <li>
          <strong><%= wtp.taste_parameter&.label || wtp.taste_parameter&.slug %></strong>
          <%= wtp.score %> / 5
        </li>
      <% end %>
    </ul>
  <% end %>
  <h2>Vintages</h2>
  <% if user_signed_in? %>
    <div class="page-actions">
      <%= link_to "+ Add Vintage", new_vintage_path(wine_id: @wine.id), class: "btn" %>
    </div>
  <% end %>
  <% if @wine.vintages.any? %>
    <ul class="vintage-list">
      <% @wine.vintages.sort_by(&:year).reverse_each do |vintage| %>
        <li>
          <strong><%= vintage.no_vintage ? "NV" : vintage.year %></strong><% if vintage.price.present? %> · <%= number_to_currency(vintage.price) %><% end %><br>
          <%= vintage.prompt %>
          <% if user_signed_in? %>
            <div class="card-actions">
              <%= link_to "Edit", edit_vintage_path(vintage.slug), class: "card-action" %>
              <%= button_to "Delete", vintage_path(vintage.slug), method: :delete, form_class: "card-delete-form", class: "card-action card-action--delete", onclick: %(return confirm('Delete the #{vintage.year} vintage? This action cannot be undone.')) %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty">No vintage notes are available yet.</p>
  <% end %>
</article>
