<%= form_with model: @wine, local: true do |f| %>
  <div>
    <%= f.label :winery_id %><br>
    <%= f.collection_select :winery_id, Winery.order(:name), :id, :name, include_blank: true %>
  </div>
  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :region %><br>
    <%= f.text_field :region %>
  </div>
  <div>
    <%= f.label :color %><br>
    <%= f.select :color, Wine.colors.keys, include_blank: true %>
  </div>
  <div>
    <%= f.label :closure %><br>
    <%= f.text_field :closure %>
  </div>
  <div>
    <%= f.label :alcohol_percentage %><br>
    <%= f.number_field :alcohol_percentage, step: 0.1 %>
  </div>
  <div>
    <%= f.label :volume_ml %><br>
    <%= f.number_field :volume_ml %>
  </div>
  <div>
    <%= f.label :prompt %><br>
    <%= f.text_area :prompt %>
  </div>
  <div><%= f.submit %></div>
<% end %>
