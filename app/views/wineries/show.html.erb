<% content_for :title, "#{@winery.name} · Wineries" %>
<article class="winery-page">
  <%= link_to "← All wineries", wineries_path, class: "back-link" %>
  <h1><%= @winery.name %></h1>
  <ul class="facts" aria-label="Winery details">
    <% if @winery.address.present? %>
      <li><strong>Address:</strong> <%= @winery.address %></li>
    <% end %>
    <% if @winery.email.present? %>
      <li><strong>Email:</strong> <%= @winery.email %></li>
    <% end %>
  </ul>
  <h2>Wines</h2>
  <% if @winery.wines.any? %>
    <ul class="wine-list">
      <% @winery.wines.each do |wine| %>
        <li><%= link_to wine.name, wine_path(wine.slug) %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty">No wines are associated with this winery yet.</p>
  <% end %>
</article>