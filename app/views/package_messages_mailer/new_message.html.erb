<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New message on trade submission #<%= @package.id %></title>
  </head>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #241b19; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: linear-gradient(135deg, #4a1020, #27615e); padding: 30px; border-radius: 12px 12px 0 0; text-align: center;">
      <h1 style="color: white; margin: 0; font-size: 28px;">Wine Words</h1>
      <p style="color: rgba(255,255,255,0.9); margin: 10px 0 0;">New message on trade submission #<%= @package.id %></p>
    </div>

    <div style="background: #fffaf4; border: 1px solid #e4d9cd; border-top: none; border-radius: 0 0 12px 12px; padding: 30px;">
      <p>Hello <%= @recipient&.display_name.presence || @contact_name.presence || "there" %>,</p>

      <p><strong><%= @sender_name %></strong> wrote about
        <%= @company_name.presence || "your submission" %>:</p>

      <div style="background: white; border: 1px solid #e4d9cd; border-radius: 8px; padding: 20px; margin: 20px 0;">
        <p style="white-space: pre-wrap; margin: 0;"><%= @body %></p>
      </div>

      <p style="text-align: center; margin: 30px 0;">
        <a href="<%= @url %>" style="display: inline-block; background: #4a1020; color: white; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600;"><%= @staff_recipient ? "Open the submission" : "Open my submission" %></a>
      </p>

      <p style="font-size: 14px; color: #766963; word-break: break-all;">
        Or copy this link: <br>
        <span style="font-family: monospace; background: #efe5dc; padding: 4px 8px; border-radius: 4px;"><%= @url %></span>
      </p>

      <hr style="border: none; border-top: 1px solid #e4d9cd; margin: 30px 0;">

      <p style="font-size: 14px; color: #766963;">
        <%= @staff_recipient ? "You receive this because your account has the Editor or Admin role. The same message is in your in-app notifications." : "You receive this because you submitted wines to Wine Words. The same message is in your account notifications." %>
      </p>
    </div>
  </body>
</html>

