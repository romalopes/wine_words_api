<%= form_with model: @region, local: true do |f| %>
  <div class="auth-form__field">
    <%= f.label :name, "Name *" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="auth-form__field">
    <%= f.label :country_id, "Country *" %>
    <%= f.collection_select :country_id, @countries, :id,
          lambda { |c| "#{c.flag_emoji} #{c.name}" },
          { include_blank: "Select a country...", prompt: "Select a country..." },
          required: true %>
  </div>

  <div class="auth-form__field">
    <%= f.label :parent_id, "Parent Region" %>
    <%= f.collection_select :parent_id, @parent_regions, :id, :name,
          { include_blank: "No parent (top-level)", prompt: "No parent" },
          style: "max-width: 300px" %>
  </div>

  <div class="auth-form__field auth-form__field--checkbox">
    <%= f.check_box :is_state %>
    <%= f.label :is_state, "Is State/Province", class: "checkbox-label" %>
  </div>

  <div class="auth-form__field auth-form__field--checkbox">
    <%= f.check_box :is_appellation %>
    <%= f.label :is_appellation, "Is Appellation", class: "checkbox-label" %>
  </div>

  <div class="auth-form__actions">
    <%= f.submit class: "auth-form__submit" %>
    <%= link_to "Cancel", regions_path, class: "btn" %>
  </div>
<% end %>