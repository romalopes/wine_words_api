<h1>Edit Category</h1>
<%= form_with(model: @category, local: true) do |form| %>
  <% if @category.errors.any? %>
    <div class="flash flash--alert"><%= @category.errors.full_messages.join(", ") %></div>
  <% end %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>
  <fieldset class="category-flags">
    <legend>Applies to</legend>
    <label><%= form.check_box :for_wine %> Wine</label>
    <label><%= form.check_box :for_review %> Review</label>
    <label><%= form.check_box :for_article %> Article</label>
  </fieldset>
  <div class="page-actions">
    <%= form.submit "Update", class: "btn" %>
    <%= link_to "Cancel", categories_path, class: "btn btn--secondary" %>
  </div>
<% end %>