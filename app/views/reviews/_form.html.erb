<%= stylesheet_link_tag "https://unpkg.com/trix@2.1.15/dist/trix.css" %>
<script type="text/javascript" src="https://unpkg.com/trix@2.1.15/dist/trix.umd.min.js"></script>
<style>
  trix-editor { background: #fff; border: 1px solid #d8c8c0; border-radius: .45rem; }
  trix-editor:empty::before { content: attr(placeholder); color: #6b5855; }
  .wine-picker { display: grid; gap: .5rem; }
  .wine-picker__input { width: 100%; border: 1px solid #d8c8c0; border-radius: .45rem; padding: .6rem .75rem; font: 1rem system-ui, sans-serif; }
  .wine-picker__input:focus { outline: none; border-color: #8a273c; box-shadow: 0 0 0 3px rgba(138, 39, 60, .12); }
  .wine-picker__results { display: grid; gap: .4rem; margin-bottom: .5rem; }
  .wine-pick-btn { display: flex; justify-content: space-between; align-items: center; gap: .75rem; width: 100%; text-align: left; background: #fff; border: 1px solid #eaded7; border-radius: .55rem; padding: .6rem .85rem; font: .95rem system-ui, sans-serif; color: #281919; cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .wine-pick-btn:hover { border-color: #8a273c; box-shadow: 0 2px 10px rgba(63, 24, 24, .08); transform: translateY(-1px); }
  .wine-pick-btn strong { color: #6b2834; }
  .wine-pick-btn .wine-pick-btn__meta { color: #6b5855; font-size: .82rem; }
  .wine-pick-btn--selected { border-color: #8a273c; background: #faf1ee; }
</style>
<%= form_with model: review, local: true, html: { multipart: true } do |f| %>
  <div>
    <%= f.label :vintage_id, "Wine & Vintage" %><br>
    <%= f.hidden_field :vintage_id, id: "review_vintage_id" %>
    <% if review.vintage.present? %>
      <div id="wine-current-selection" class="wine-picker">
        <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
          <p class="wine-pick-btn wine-pick-btn--selected" style="margin:0;cursor:default;flex:1;min-width:14rem">
            <strong><%= review.vintage.wine&.name %></strong>
            <% if review.vintage.year %>
              <span class="wine-pick-btn__meta"><%= review.vintage.year %></span>
            <% end %>
          </p>
          <%= button_tag "Change wine/vintage", type: "button", id: "wine-change-btn",
                class: "btn btn--secondary" %>
        </div>
      </div>
    <% end %>
    <div id="wine-search-fields" class="wine-picker" style="<%= "display:none" if review.vintage.present? %>">
      <input type="text" id="review-vintage-search" placeholder="Type to search wines…"
             class="wine-picker__input" autocomplete="off">
      <div id="wine-search-status" class="lede" style="display:none"></div>
      <div id="wine-search-results" class="wine-picker__results"></div>
      <% if review.vintage.present? %>
        <%= button_tag "Cancel", type: "button", id: "wine-change-cancel",
              class: "card-action" %>
      <% end %>
      <small class="lede">Search the wine by name, then pick its vintage.</small>
    </div>
  </div>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :score %><br>
    <%= f.number_field :score, min: 0, max: 100, step: 0.01 %>
  </div>
  <div>
    <%= f.label :drink_from, "Drink from" %><br>
    <%= f.number_field :drink_from, min: review.vintage&.year || 1900,
          placeholder: "e.g. #{review.vintage&.year || 2020}" %>
    <small class="lede">Defaults start at the vintage year.</small>
  </div>
  <div>
    <%= f.label :drink_to, "Drink to" %><br>
    <%= f.number_field :drink_to %>
  </div>
  <div>
    <%= f.check_box :drink_plus %>
    <%= f.label :drink_plus, "Can be extended (+)" %>
  </div>
  <div class="field">
    <%= f.label :category_id, "Category" %><br>
    <%= f.collection_select :category_id, Category.where(for_review: true).order(sort_order_review: :asc), :id, :name, include_blank: true %>
  </div>
  <div>
    <%= f.label :comment %><br>
    <%= f.hidden_field :comment, id: "review_comment_input" %>
    <trix-editor input="review_comment_input" placeholder="Write your tasting notes…"></trix-editor>
  </div>
  <div>
    <%= f.label :status %><br>
    <%= f.select :status, %w[draft published], include_blank: true %>
  </div>
  <div>
    <%= f.label :published_at %><br>
    <%= f.datetime_field :published_at %>
  </div>
  <div>
    <%= f.label :images, "Images" %>
    <%= f.file_field :images, multiple: true, direct_upload: false %>
  </div>
  <div><%= f.submit class: "btn" %></div>
<% end %>
<% if review.images.attached? %>
  <div class="image-gallery">
    <p class="lede">Existing images (click Remove to delete)</p>
    <% review.images.each do |image| %>
      <div class="image-gallery__item">
        <%= image_tag url_for(image), class: "gallery-img", alt: review.title %>
        <%= button_to "Remove", purge_image_review_path(review.id), method: :patch, params: { image_id: image.id }, class: "image-gallery__remove" %>
      </div>
    <% end %>
  </div>
<% end %>
<script>
  (function () {
    var hiddenVintage = document.getElementById("review_vintage_id");
    var search = document.getElementById("review-vintage-search");
    var resultsBox = document.getElementById("wine-search-results");
    var statusBox = document.getElementById("wine-search-status");
    if (!hiddenVintage || !search || !resultsBox || !statusBox) return;

    // "Change wine/vintage" — reveal the search UI on edit, keeping the
    // current vintage_id until a new wine/vintage is picked.
    var changeBtn = document.getElementById("wine-change-btn");
    var currentSelection = document.getElementById("wine-current-selection");
    var searchFields = document.getElementById("wine-search-fields");
    if (changeBtn && currentSelection && searchFields) {
      changeBtn.addEventListener("click", function () {
        currentSelection.style.display = "none";
        searchFields.style.display = "";
        search.focus();
      });
      var cancelBtn = document.getElementById("wine-change-cancel");
      if (cancelBtn) {
        cancelBtn.addEventListener("click", function () {
          searchFields.style.display = "none";
          currentSelection.style.display = "";
          // Keep the original vintage_id — nothing was changed.
        });
      }
    }

    var timer = null;
    var selectedWine = null;
    var NEW_WINE_URL = "<%= new_wine_path %>";

    function setStatus(text) {
      statusBox.textContent = text;
      statusBox.style.display = text ? "" : "none";
    }

    function clearResults() { resultsBox.innerHTML = ""; }

    function makeButton(label, meta, onClick) {
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "wine-pick-btn";
      var name = document.createElement("strong");
      name.textContent = label;
      btn.appendChild(name);
      if (meta) {
        var m = document.createElement("span");
        m.className = "wine-pick-btn__meta";
        m.textContent = meta;
        btn.appendChild(m);
      }
      btn.addEventListener("click", onClick);
      return btn;
    }

    function selectWine(wine) {
      selectedWine = wine;
      clearResults();
      setStatus("Reviewing \u201C" + wine.name + "\u201D — choose a vintage:");

      if (!wine.vintages || wine.vintages.length === 0) {
        resultsBox.appendChild(document.createElement("p"))
          .textContent = "No vintages yet for this wine.";
      }
      wine.vintages.forEach(function (vintage) {
        resultsBox.appendChild(makeButton(String(vintage.year), "", function () {
          hiddenVintage.value = vintage.id;
          setStatus("Selected: " + wine.name + " (" + vintage.year + ")");
          clearResults();
          var done = document.createElement("p");
          done.className = "wine-pick-btn wine-pick-btn--selected";
          done.style.cursor = "default";
          done.innerHTML = "<strong>" + wine.name + "</strong>" +
            "<span class='wine-pick-btn__meta'>" + vintage.year + "</span>";
          resultsBox.appendChild(done);
        }));
      });
    }

    function runSearch() {
      var q = search.value.trim();
      if (q.length < 2) { clearResults(); setStatus(""); return; }
      setStatus("Searching…");
      fetch("/wines/search?q=" + encodeURIComponent(q), {
        headers: { "Accept": "application/json" }
      })
        .then(function (res) { return res.json(); })
        .then(function (wines) {
          clearResults();
          if (!Array.isArray(wines) || wines.length === 0) {
            setStatus("No wine found.");
            var add = makeButton("+ Add \u201C" + q + "\u201D as a new wine", "", function () {
              window.location = NEW_WINE_URL;
            });
            resultsBox.appendChild(add);
            return;
          }
          setStatus(wines.length + " wine" + (wines.length === 1 ? "" : "s") +
            " found — pick one:");
          wines.forEach(function (wine) {
            resultsBox.appendChild(makeButton(
              wine.name,
              [wine.color].filter(Boolean).join(" · "),
              function () {
                if (selectedWine !== wine) selectWine(wine);
              }
            ));
          });
        })
        .catch(function () { setStatus("Search failed. Please try again."); });
    }

    search.addEventListener("input", function () {
      if (timer) clearTimeout(timer);
      timer = setTimeout(runSearch, 300);
    });
  })();
</script>