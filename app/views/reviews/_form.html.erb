<%= stylesheet_link_tag "https://unpkg.com/trix@2.1.15/dist/trix.css" %>
<script type="text/javascript" src="https://unpkg.com/trix@2.1.15/dist/trix.umd.min.js"></script>
<style>
  trix-editor { background: #fff; border: 1px solid #d8c8c0; border-radius: .45rem; }
  trix-editor:empty::before { content: attr(placeholder); color: #6b5855; }
</style>

<%= form_with model: review, local: true, html: { multipart: true } do |f| %>
  <div>
    <%= f.label :vintage_id %><br>
    <input type="text" id="review-vintage-search" placeholder="Type to search wines…"
           style="width: 100%; margin-bottom: .35rem" autocomplete="off">
    <%= f.grouped_collection_select :vintage_id, Wine.order(:name), :vintages,
          :name, :id, :name,
          { include_blank: true },
          { id: "review_vintage_id" } %>
    <small class="lede">Pick the wine's vintage this review is about.</small>
  </div>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :score %><br>
    <%= f.number_field :score, min: 0, max: 100, step: 0.01 %>
  </div>
  <div>
    <%= f.label :comment %><br>
    <%= f.hidden_field :comment, id: "review_comment_input" %>
    <trix-editor input="review_comment_input" placeholder="Write your tasting notes…"></trix-editor>
  </div>
  <div>
    <%= f.label :status %><br>
    <%= f.select :status, %w[draft published], include_blank: true %>
  </div>
  <div>
    <%= f.label :published_at %><br>
    <%= f.datetime_field :published_at %>
  </div>
  <div>
    <%= f.label :images, "Images" %>
    <%= f.file_field :images, multiple: true, direct_upload: false %>
  </div>
  <div><%= f.submit %></div>
<% end %>

<% if @review.images.attached? %>
  <div class="image-gallery">
    <p class="lede">Existing images (click Remove to delete)</p>
    <% @review.images.each do |image| %>
      <div class="image-gallery__item">
        <%= image_tag url_for(image), class: "gallery-img", alt: @review.title %>
        <%= button_to "Remove", purge_image_review_path(@review.id), method: :patch, params: { image_id: image.id }, class: "image-gallery__remove" %>
      </div>
    <% end %>
  </div>
<% end %>

<script>
(function () {
  var select = document.getElementById("review_vintage_id");
  var search = document.getElementById("review-vintage-search");
  if (!select || !search) return;

  search.addEventListener("input", function () {
    var q = search.value.trim().toLowerCase();
    Array.from(select.getElementsByTagName("optgroup")).forEach(function (optgroup) {
      Array.from(optgroup.getElementsByTagName("option")).forEach(function (option) {
        var wineName = optgroup.getAttribute("label") || "";
        option.hidden =
          !!q && option.text.toLowerCase().indexOf(q) === -1 &&
          wineName.toLowerCase().indexOf(q) === -1;
      });
      var anyVisible = Array.from(optgroup.getElementsByTagName("option"))
        .some(function (option) { return !option.hidden; });
      optgroup.style.display = anyVisible ? "" : "none";
    });
  });
})();
</script>