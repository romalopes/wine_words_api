<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || "Wine Library" %></title>
    <%= csrf_meta_tags %>
    <style>
      :root { color: #281919; background: #faf7f2; font-family: Georgia, "Times New Roman", serif; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      a { color: inherit; }
      .site-header { background: #4a1020; color: #fff8f0; padding: 1.25rem max(1.5rem, calc((100vw - 72rem) / 2)); }
      .site-header a { text-decoration: none; }
      .site-header__title { font-size: 1.45rem; font-weight: 700; letter-spacing: .02em; }
      .site-header__subtitle { margin: .25rem 0 0; color: #ead7d1; font: 0.9rem system-ui, sans-serif; }
      main { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
      h1, h2, p { margin-top: 0; }
      h1 { color: #4a1020; font-size: clamp(2rem, 5vw, 3.25rem); margin-bottom: .5rem; }
      .lede { color: #6b5855; font: 1.05rem/1.6 system-ui, sans-serif; margin-bottom: 2rem; }
      .wine-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
      .wine-card { display: block; background: #fff; border: 1px solid #eaded7; border-radius: .7rem; box-shadow: 0 2px 10px rgba(63, 24, 24, .06); overflow: hidden; text-decoration: none; transition: transform .15s, box-shadow .15s; }
      .wine-card:hover { transform: translateY(-3px); box-shadow: 0 7px 18px rgba(63, 24, 24, .14); }
      .wine-card__band { height: .5rem; background: #8a273c; }
      .wine-card--white .wine-card__band { background: #c49b38; }
      .wine-card--rose .wine-card__band, .wine-card--rosé .wine-card__band { background: #d47386; }
      .wine-card__content { padding: 1.1rem; }
      .wine-card h2 { font-size: 1.25rem; margin-bottom: .3rem; }
      .region, .details, .vintages, .back-link { color: #6b5855; font: .9rem/1.5 system-ui, sans-serif; }
      .details { margin: .7rem 0; }
      .tag { display: inline-block; background: #f3e9e3; border-radius: 99px; color: #6b2834; font: .78rem system-ui, sans-serif; margin: .15rem .25rem 0 0; padding: .22rem .5rem; }
      .wine-page { max-width: 48rem; }
      .back-link { display: inline-block; margin-bottom: 1.5rem; }
      .facts { display: flex; flex-wrap: wrap; gap: .75rem; list-style: none; margin: 1.5rem 0 2rem; padding: 0; }
      .facts li { background: #fff; border: 1px solid #eaded7; border-radius: .45rem; padding: .7rem .9rem; font: .9rem system-ui, sans-serif; }
      .prompt { border-left: 4px solid #8a273c; color: #513e3b; font-size: 1.1rem; line-height: 1.65; padding-left: 1rem; }
      .vintage-list { display: grid; gap: .8rem; padding: 0; list-style: none; }
      .vintage-list li { background: #fff; border: 1px solid #eaded7; border-radius: .5rem; padding: 1rem; }
      .vintage-list strong { color: #6b2834; }
      .empty { color: #6b5855; font: 1rem system-ui, sans-serif; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <%= link_to root_path do %>
        <div class="site-header__title">Wine Library</div>
        <p class="site-header__subtitle">Explore wines and their vintages</p>
      <% end %>
    </header>
    <main><%= yield %></main>
  </body>
</html>
