<%# locals: article %>
<%= stylesheet_link_tag "https://unpkg.com/trix@2.1.15/dist/trix.css" %>
<script type="text/javascript" src="https://unpkg.com/trix@2.1.15/dist/trix.umd.min.js"></script>
<style>
  trix-editor { background: #fff; border: 1px solid #d8c8c0; border-radius: .45rem; min-height: 14rem; }
  trix-editor:empty::before { content: attr(placeholder); color: #6b5855; }
</style>

<%= form_with(model: article, local: true, html: { multipart: true }, class: "article-form") do |form| %>
  <% if article.errors.any? %>
    <div class="flash flash--alert">
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "Title" %>
    <%= form.text_field :title, required: true, style: "width: 100%" %>
  </div>

  <div class="field">
    <%= form.label :abstract, "Abstract" %>
    <%= form.text_area :abstract, rows: 3, style: "width: 100%" %>
  </div>

  <div class="field">
    <%= form.label :body, "Body" %>
    <%= form.hidden_field :body, id: "article_body_input" %>
    <trix-editor input="article_body_input" placeholder="Write your story…"></trix-editor>
  </div>

  <div class="field">
    <%= form.label :category_id, "Category" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
          include_blank: "None" %>
  </div>

  <div class="field">
    <%= form.label :tag_names, "Tags (comma separated)" %>
    <%= form.text_field :tag_names, value: article.tags.map(&:name).join(", "), style: "width: 100%" %>
  </div>

  <div class="field">
    <%= form.label :vintage_ids, "Wine vintages" %>
    <input type="text" id="vintage-search" placeholder="Type to search wines…"
           style="width: 100%; margin-bottom: .35rem" autocomplete="off">
    <%= form.grouped_collection_select :vintage_ids, Wine.order(:name), :vintages,
          :name, :id, :name,
          { include_hidden: false },
          { multiple: true, size: 8, style: "width: 100%", id: "article_vintage_ids" } %>
    <small class="lede">Ctrl/Cmd-click to pick several vintages.</small>
  </div>

  <div class="field">
    <%= form.label :review_ids, "Reviews (optional — pick from the vintages above)" %>
    <div id="per-vintage-reviews" class="review-groups">
      <% Review.published.includes(vintage: :wine).order("wines.name", year: :desc, title: :asc).each do |review| %>
        <div class="review-option" data-vintage-id="<%= review.vintage_id %>">
          <label style="font-weight: 400">
            <%= check_box_tag "article[review_ids][]", review.id, article.review_ids.include?(review.id) %>
            <%= review.title.presence || "Untitled" %>
            (<%= review.vintage&.name %>, score <%= review.score %>)
          </label>
        </div>
      <% end %>
      <% if Review.published.none? %>
        <p class="empty">No published reviews yet.</p>
      <% end %>
    </div>
  </div>

  <div class="field">
    <%= form.label :producer_ids, "Producers" %>
    <%= form.collection_select :producer_ids, Producer.order(:name), :id, :name,
          { include_hidden: false }, { multiple: true, size: 6, style: "width: 100%" } %>
  </div>

  <div class="field">
    <%= form.label :images, "Images (shown at the top of the article)" %>
    <%= form.file_field :images, multiple: true, accept: "image/*" %>
  </div>

  <div class="page-actions">
    <%= form.hidden_field :status, value: article.status || "draft", id: "article_status_hidden" %>
    <button type="submit" class="btn"
            onclick="document.getElementById('article_status_hidden').value = 'draft'">
      Save as Draft
    </button>
    <button type="submit" class="btn btn--secondary"
            onclick="document.getElementById('article_status_hidden').value = 'published'">
      Publish
    </button>
    <%= link_to "Cancel", article.persisted? ? article_path(article) : articles_path, class: "btn btn--secondary" %>
  </div>
<% end %>

<% if article.images.attached? %>
  <div class="image-gallery">
    <p class="lede">Existing images (click Remove to delete)</p>
    <% article.images.each do |image| %>
      <div class="image-gallery__item">
        <%= image_tag url_for(image), class: "gallery-img", alt: article.title %>
        <%= button_to "Remove", purge_image_article_path(article.id), method: :patch, params: { image_id: image.id }, class: "image-gallery__remove" %>
      </div>
    <% end %>
  </div>
<% end %>

<script>
(function () {
  var select = document.getElementById("article_vintage_ids");
  var search = document.getElementById("vintage-search");
  if (!select) return;

  function selectedVintageIds() {
    return new Set(Array.from(select.selectedOptions).map(function (o) { return o.value; }));
  }

  // Show only review options whose vintage is currently selected.
  function updateReviewVisibility() {
    var ids = selectedVintageIds();
    document.querySelectorAll(".review-option").forEach(function (el) {
      el.style.display = ids.has(el.getAttribute("data-vintage-id")) ? "" : "none";
    });
  }

  // Filter the vintage options by the search box text.
  if (search) {
    search.addEventListener("input", function () {
      var q = search.value.trim().toLowerCase();
      Array.from(select.getElementsByTagName("optgroup")).forEach(function (optgroup) {
        Array.from(optgroup.getElementsByTagName("option")).forEach(function (option) {
          var wineName = optgroup.getAttribute("label") || "";
          option.style.display =
            !q || option.text.toLowerCase().indexOf(q) !== -1 ||
            wineName.toLowerCase().indexOf(q) !== -1 ? "" : "none";
        });
        var anyVisible = Array.from(optgroup.getElementsByTagName("option"))
          .some(function (option) { return option.style.display !== "none"; });
        optgroup.style.display = anyVisible ? "" : "none";
      });
    });
  }

  select.addEventListener("change", updateReviewVisibility);
  updateReviewVisibility();
})();
</script>