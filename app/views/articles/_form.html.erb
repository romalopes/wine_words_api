<%# locals: article %>
<%= stylesheet_link_tag "https://unpkg.com/trix@2.1.15/dist/trix.css" %>
<script type="text/javascript" src="https://unpkg.com/trix@2.1.15/dist/trix.umd.min.js"></script>
<style>
  trix-editor { background: #fff; border: 1px solid #d8c8c0; border-radius: .45rem; min-height: 14rem; }
  trix-editor:empty::before { content: attr(placeholder); color: #6b5855; }
</style>

<%= form_with(model: article, local: true, html: { multipart: true }, class: "article-form") do |form| %>
  <% if article.errors.any? %>
    <div class="flash flash--alert">
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "Title" %>
    <%= form.text_field :title, required: true, style: "width: 100%" %>
  </div>

  <div class="field">
    <%= form.label :abstract, "Abstract" %>
    <%= form.text_area :abstract, rows: 3, style: "width: 100%" %>
  </div>

  <div class="field">
    <%= form.label :body, "Body" %>
    <%= form.hidden_field :body, id: "article_body_input" %>
    <trix-editor input="article_body_input" placeholder="Write your story…"></trix-editor>
  </div>

  <div class="field">
    <%= form.label :category_id, "Category" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
          include_blank: "None" %>
  </div>

  <div class="field">
    <%= form.label :tag_names, "Tags (comma separated)" %>
    <%= form.text_field :tag_names, value: article.tags.map(&:name).join(", "), style: "width: 100%" %>
  </div>

  <div class="field">
    <label>Wine vintages</label>
    <div class="wine-picker" id="vintage-picker"
         data-selected="<%= article.vintages.includes(:wine).map { |v| { id: v.id, year: v.year, wine_name: v.wine&.name, wine_slug: v.wine&.slug } }.to_json %>"
         data-linked-review-ids="<%= article.review_ids.to_json %>">
      <input type="text" id="article-wine-search" placeholder="Type to search wines…"
             class="wine-picker__input" autocomplete="off">
      <div id="article-search-status" class="lede" style="display:none"></div>
      <div id="article-wine-results" class="wine-picker__results"></div>
      <div id="selected-vintage-chips"></div>
    </div>
    <small class="lede">Search a wine, pick its vintages. Expanding “Reviews” on a chip is optional.</small>
  </div>

  <div class="field">
    <%= form.label :producer_ids, "Producers" %>
    <%= form.collection_select :producer_ids, Producer.order(:name), :id, :name,
          { include_hidden: false }, { multiple: true, size: 6, style: "width: 100%" } %>
  </div>

  <div class="field">
    <%= form.label :images, "Images (shown at the top of the article)" %>
    <%= form.file_field :images, multiple: true, accept: "image/*" %>
  </div>

  <div class="page-actions">
    <%= form.hidden_field :status, value: article.status || "draft", id: "article_status_hidden" %>
    <button type="submit" class="btn"
            onclick="document.getElementById('article_status_hidden').value = 'draft'">
      Save as Draft
    </button>
    <button type="submit" class="btn btn--secondary"
            onclick="document.getElementById('article_status_hidden').value = 'published'">
      Publish
    </button>
    <%= link_to "Cancel", article.persisted? ? article_path(article) : articles_path, class: "btn btn--secondary" %>
  </div>
<% end %>

<% if article.images.attached? %>
  <div class="image-gallery">
    <p class="lede">Existing images (click Remove to delete)</p>
    <% article.images.each do |image| %>
      <div class="image-gallery__item">
        <%= image_tag url_for(image), class: "gallery-img", alt: article.title %>
        <%= button_to "Remove", purge_image_article_path(article.id), method: :patch, params: { image_id: image.id }, class: "image-gallery__remove" %>
      </div>
    <% end %>
  </div>
<% end %>

<style>
  .wine-picker { display: grid; gap: .5rem; }
  .vintage-chip { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; background: #faf1ee; border: 1px solid #8a273c; border-radius: .55rem; padding: .55rem .75rem; font: .95rem system-ui, sans-serif; }
  .vintage-chip strong { color: #6b2834; }
  .vintage-chip__remove { background: transparent; border: none; color: #8a273c; font-weight: 700; cursor: pointer; padding: 0 .25rem; }
  .vintage-chip__reviews-toggle { background: #fff; border: 1px solid #d8c8c0; border-radius: 99px; padding: .15rem .7rem; font: .78rem system-ui, sans-serif; cursor: pointer; }
  .vintage-chip__reviews-toggle:hover { border-color: #8a273c; }
  .vintage-chip__reviews { display: grid; gap: .35rem; width: 100%; }
  .vintage-review-row { display: flex; align-items: center; gap: .5rem; background: #fff; border: 1px solid #eaded7; border-radius: .55rem; padding: .45rem .75rem; font: .92rem system-ui, sans-serif; cursor: pointer; }
  .vintage-review-row:hover { border-color: #8a273c; }
</style>

<script>
(function () {
  var picker = document.getElementById("vintage-picker");
  var search = document.getElementById("article-wine-search");
  if (!picker || !search) return;
  var statusBox = document.getElementById("article-search-status");
  var resultsBox = document.getElementById("article-wine-results");
  var chipsBox = document.getElementById("selected-vintage-chips");

  var timer = null;
  // selected[vintageId] = { id, year, wine_name, wine_slug }
  var selected = {};
  try {
    JSON.parse(picker.getAttribute("data-selected") || "[]").forEach(function (v) {
      selected[v.id] = v;
    });
  } catch (e) { /* ignore */ }

  var linkedReviewIds = [];
  try {
    linkedReviewIds = JSON.parse(picker.getAttribute("data-linked-review-ids") || "[]")
      .map(function (n) { return String(n); });
  } catch (e) { /* ignore */ }

  function setStatus(text) {
    statusBox.textContent = text;
    statusBox.style.display = text ? "" : "none";
  }

  function clearResults() { resultsBox.innerHTML = ""; }

  function pickButton(label, meta, onClick) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "wine-pick-btn";
    var name = document.createElement("strong");
    name.textContent = label;
    btn.appendChild(name);
    if (meta) {
      var m = document.createElement("span");
      m.className = "wine-pick-btn__meta";
      m.textContent = meta;
      btn.appendChild(m);
    }
    btn.addEventListener("click", onClick);
    return btn;
  }

  function fetchReviews(wineSlug, vintageId, container) {
    container.textContent = "Loading reviews…";
    fetch("/wines/" + wineSlug + "/vintages/" + vintageId + "/reviews", {
      headers: { "Accept": "application/json" }
    })
      .then(function (res) { return res.json(); })
      .then(function (reviews) {
        container.innerHTML = "";
        if (!Array.isArray(reviews) || reviews.length === 0) {
          container.textContent = "No published reviews of yours for this vintage.";
          return;
        }
        reviews.forEach(function (review) {
          var row = document.createElement("label");
          row.className = "vintage-review-row";
          var box = document.createElement("input");
          box.type = "checkbox";
          box.name = "article[review_ids][]";
          box.value = review.id;
          box.checked = linkedReviewIds.indexOf(String(review.id)) !== -1;
          row.appendChild(box);
          var span = document.createElement("span");
          span.innerHTML = "<strong>" + review.title + "</strong>" +
            " <span class='wine-pick-btn__meta'>(score " + review.score + ")</span>";
          row.appendChild(span);
          container.appendChild(row);
        });
      })
      .catch(function () { container.textContent = "Could not load reviews."; });
  }

  function renderChips() {
    chipsBox.innerHTML = "";
    Object.keys(selected).forEach(function (key) {
      var v = selected[key];
      var chip = document.createElement("div");
      chip.className = "vintage-chip";

      var label = document.createElement("strong");
      label.textContent = (v.wine_name || v.wine_slug || "Wine") + " · " + v.year;
      chip.appendChild(label);

      var removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "vintage-chip__remove";
      removeBtn.title = "Remove this vintage";
      removeBtn.textContent = "✕";
      removeBtn.addEventListener("click", function () {
        delete selected[key];
        renderChips();
      });
      chip.appendChild(removeBtn);

      var reviewsToggle = document.createElement("button");
      reviewsToggle.type = "button";
      reviewsToggle.className = "vintage-chip__reviews-toggle";
      reviewsToggle.textContent = "Reviews ▸";
      var reviewsBox = null;
      reviewsToggle.addEventListener("click", function () {
        if (reviewsBox) {
          reviewsBox.remove();
          reviewsBox = null;
          reviewsToggle.textContent = "Reviews ▸";
          return;
        }
        reviewsBox = document.createElement("div");
        reviewsBox.className = "vintage-chip__reviews";
        chip.appendChild(reviewsBox);
        reviewsToggle.textContent = "Reviews ▾";
        fetchReviews(v.wine_slug, v.id, reviewsBox);
      });
      chip.appendChild(reviewsToggle);

      var hidden = document.createElement("input");
      hidden.type = "hidden";
      hidden.name = "article[vintage_ids][]";
      hidden.value = v.id;
      chip.appendChild(hidden);

      chipsBox.appendChild(chip);
    });
  }

  function runSearch() {
    var q = search.value.trim();
    if (q.length < 2) { clearResults(); setStatus(""); return; }
    setStatus("Searching…");
    fetch("/wines/search?q=" + encodeURIComponent(q), {
      headers: { "Accept": "application/json" }
    })
      .then(function (res) { return res.json(); })
      .then(function (wines) {
        clearResults();
        if (!Array.isArray(wines) || wines.length === 0) {
          setStatus("No wine found.");
          return;
        }
        setStatus(wines.length + " wine" + (wines.length === 1 ? "" : "s") +
          " found — click a vintage to select it:");
        wines.forEach(function (wine) {
          (wine.vintages || []).forEach(function (vintage) {
            var isPicked = !!selected[vintage.id];
            resultsBox.appendChild(pickButton(
              wine.name,
              [vintage.year, wine.color].filter(Boolean).join(" · ") +
                (isPicked ? " ✓" : ""),
              function () {
                if (selected[vintage.id]) {
                  delete selected[vintage.id];
                } else {
                  selected[vintage.id] = {
                    id: vintage.id,
                    year: vintage.year,
                    wine_name: wine.name,
                    wine_slug: wine.slug
                  };
                }
                renderChips();
                runSearch();
              }
            ));
          });
        });
      })
      .catch(function () { setStatus("Search failed. Please try again."); });
  }

  search.addEventListener("input", function () {
    if (timer) clearTimeout(timer);
    timer = setTimeout(runSearch, 300);
  });

  renderChips();
})();
</script>
</script>

<% unless article.persisted? %>
<style>
  .wine-picker { display: grid; gap: .5rem; }
  .wine-picker__input { width: 100%; border: 1px solid #d8c8c0; border-radius: .45rem; padding: .6rem .75rem; font: 1rem system-ui, sans-serif; }
  .wine-picker__input:focus { outline: none; border-color: #8a273c; box-shadow: 0 0 0 3px rgba(138, 39, 60, .12); }
  .wine-picker__results { display: grid; gap: .4rem; }
  .wine-pick-btn { display: flex; justify-content: space-between; align-items: center; gap: .75rem; width: 100%; text-align: left; background: #fff; border: 1px solid #eaded7; border-radius: .55rem; padding: .6rem .85rem; font: .95rem system-ui, sans-serif; color: #281919; cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .wine-pick-btn:hover { border-color: #8a273c; box-shadow: 0 2px 10px rgba(63, 24, 24, .08); transform: translateY(-1px); }
  .wine-pick-btn strong { color: #6b2834; }
  .wine-pick-btn .wine-pick-btn__meta { color: #6b5855; font-size: .82rem; }
  .vintage-review-row { display: flex; align-items: center; gap: .5rem; background: #fff; border: 1px solid #eaded7; border-radius: .55rem; padding: .55rem .85rem; font: .95rem system-ui, sans-serif; cursor: pointer; }
  .vintage-review-row:hover { border-color: #8a273c; }
</style>

<script>
(function () {
  var search = document.getElementById("article-wine-search");
  if (!search) return;
  var statusBox = document.getElementById("article-search-status");
  var resultsBox = document.getElementById("article-wine-results");

  var timer = null;

  function setStatus(text) {
    statusBox.textContent = text;
    statusBox.style.display = text ? "" : "none";
  }

  function clearResults() { resultsBox.innerHTML = ""; }

  function pickButton(label, meta, onClick) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "wine-pick-btn";
    var name = document.createElement("strong");
    name.textContent = label;
    btn.appendChild(name);
    if (meta) {
      var m = document.createElement("span");
      m.className = "wine-pick-btn__meta";
      m.textContent = meta;
      btn.appendChild(m);
    }
    btn.addEventListener("click", onClick);
    return btn;
  }

  function showReviews(wine, vintage) {
    clearResults();
    setStatus("Loading published reviews for " + wine.name + " " + vintage.year + "…");

    fetch("/wines/" + wine.slug + "/vintages/" + vintage.id + "/reviews", {
      headers: { "Accept": "application/json" }
    })
      .then(function (res) { return res.json(); })
      .then(function (reviews) {
        clearResults();
        var heading = document.createElement("p");
        heading.innerHTML = "<strong>" + wine.name + " — " + vintage.year + "</strong> (tick to link):";
        resultsBox.appendChild(heading);

        if (!Array.isArray(reviews) || reviews.length === 0) {
          resultsBox.appendChild(document.createElement("p")).textContent =
            "No published reviews of yours for this vintage.";
          return;
        }

        reviews.forEach(function (review) {
          if (document.getElementById("review-check-" + review.id)) return;
          var row = document.createElement("label");
          row.className = "vintage-review-row";
          var box = document.createElement("input");
          box.type = "checkbox";
          box.name = "article[review_ids][]";
          box.id = "review-check-" + review.id;
          box.value = review.id;
          row.appendChild(box);
          var span = document.createElement("span");
          span.innerHTML = "<strong>" + review.title + "</strong>" +
            " <span class='wine-pick-btn__meta'>(score " + review.score + ")</span>";
          row.appendChild(span);
          resultsBox.appendChild(row);
        });
      })
      .catch(function () { setStatus("Could not load reviews."); });
  }

  function runSearch() {
    var q = search.value.trim();
    if (q.length < 2) { clearResults(); setStatus(""); return; }
    setStatus("Searching…");
    fetch("/wines/search?q=" + encodeURIComponent(q), {
      headers: { "Accept": "application/json" }
    })
      .then(function (res) { return res.json(); })
      .then(function (wines) {
        clearResults();
        if (!Array.isArray(wines) || wines.length === 0) {
          setStatus("No wine found.");
          return;
        }
        setStatus(wines.length + " wine" + (wines.length === 1 ? "" : "s") +
          " found — pick a vintage:");
        wines.forEach(function (wine) {
          (wine.vintages || []).forEach(function (vintage) {
            resultsBox.appendChild(pickButton(
              wine.name,
              [vintage.year, wine.color].filter(Boolean).join(" · "),
              function () { showReviews(wine, vintage); }
            ));
          });
        });
      })
      .catch(function () { setStatus("Search failed. Please try again."); });
  }

  search.addEventListener("input", function () {
    if (timer) clearTimeout(timer);
    timer = setTimeout(runSearch, 300);
  });
})();
</script>
<% end %>