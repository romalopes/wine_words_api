<%= form_with model: taste_parameter, local: true do |f| %>
  <div>
    <%= f.label :label %><br>
    <%= f.text_field :label %>
  </div>
  <% TasteParameter::LABEL_LEVELS.each do |level| %>
    <div>
      <%= f.label "label_#{level}", "Level #{level} label" %><br>
      <%= f.text_field "label_#{level}" %>
    </div>
  <% end %>
  <div>
    <%= f.label :help %><br>
    <%= f.text_area :help %>
  </div>
  <div><%= f.submit class: "btn" %></div>
<% end %>