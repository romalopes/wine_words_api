<div class="auth-page">
  <section class="auth-card">
    <p class="wine-kicker">Create account</p>
    <h1>Join Wine Words</h1>
    <p class="lede">Save tasting profiles, track the wines you have tried, and sync your results across devices.</p>
    <%= form_with model: @user, url: signup_path, method: :post, local: true, class: "auth-form" do |form| %>
      <label class="auth-form__field">
        <span>Name</span>
        <%= form.text_field :name, autocomplete: "name" %>
      </label>
      <label class="auth-form__field">
        <span>Email</span>
        <%= form.email_field :email, required: true, autocomplete: "email" %>
      </label>
      <label class="auth-form__field">
        <span>Password</span>
        <%= form.password_field :password, required: true, minlength: 6, autocomplete: "new-password" %>
      </label>
      <label class="auth-form__field">
        <span>Confirm password</span>
        <%= form.password_field :password_confirmation, required: true, minlength: 6, autocomplete: "new-password" %>
      </label>
      <% if @user.errors.any? %>
        <div class="auth-form__error" role="alert">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <button class="auth-form__submit" type="submit">Create account</button>
    <% end %>
    <p class="auth-card__switch">
      Already have an account?
      <%= link_to "Sign in instead", login_path, class: "text-link" %>
    </p>
    <%= link_to "Back to dashboard", root_path, class: "back-link" %>
  </section>
</div>