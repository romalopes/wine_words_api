# Template for the local environment files (.env.development / .env.production
# are gitignored). Copy this to .env.development and fill in real values.
#
# Provider secrets belong server-side only: in production they live in the
# Render environment, never in the Vercel/React build.

# The React app's base URL. Used for links inside emails (password reset, wine
# package review-deadline reminders). Defaults to http://localhost:5173.
FRONTEND_URL=

# --- Social authentication: Google -----------------------------------------
# The OAuth client id (public). No client secret is needed: ID tokens are
# verified against Google's published JWKS.
GOOGLE_CLIENT_ID=

# --- Social authentication: Apple ------------------------------------------
# APPLE_CLIENT_ID is the Apple *Services ID* (web client id).
APPLE_CLIENT_ID=
# Team id / key id / private key (PKCS#8 PEM) are only needed for the
# authorization-code exchange. Keep the literal \n escapes on one line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Social authentication: Microsoft --------------------------------------
MICROSOFT_CLIENT_ID=
# common (default: personal + organisational) | organizations | consumers | <tenant-id>
MICROSOFT_TENANT_ID=common

# --- Social authentication: Facebook ---------------------------------------
FACEBOOK_APP_ID=
# Server-side only. Never expose this to React/Vite.
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Shipment tracking: Australia Post -------------------------------------
# Tracking is optional by design: the package workflow works without any of
# these, and a reviewer can always maintain tracking by hand.
#
# API key (server-side only). When blank, Australia Post packages still get a
# tracking URL but no live carrier data is fetched.
AUSTRALIA_POST_API_KEY=
# Optional overrides. The tracking URL is the human page a consignment number is
# appended to; the API URL is the tracking endpoint.
AUSTRALIA_POST_TRACKING_URL=
AUSTRALIA_POST_API_URL=

# --- Private test-access gate ----------------------------------------------
# The application is in a private testing phase. Set a secret password here
# (server-side only — NEVER a VITE_* variable) to enable the gate. Leave it
# blank to disable the gate locally.
#
# Use a DIFFERENT password than the Beach Volleyball API in production.
TEST_ACCESS_PASSWORD=
# Optional token lifetime. Supports "7.days", "12.hours", "3600" (seconds)
# or ISO-8601 ("P7D"). Defaults to 7 days.
TEST_ACCESS_TOKEN_EXPIRATION=7.days

