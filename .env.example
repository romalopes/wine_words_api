# Template for the local environment files (.env.development / .env.production
# are gitignored). Copy this to .env.development and fill in real values.
#
# Provider secrets belong server-side only: in production they live in the
# Render environment, never in the Vercel/React build.

# --- Social authentication: Google -----------------------------------------
# The OAuth client id (public). No client secret is needed: ID tokens are
# verified against Google's published JWKS.
GOOGLE_CLIENT_ID=

# --- Social authentication: Apple ------------------------------------------
# APPLE_CLIENT_ID is the Apple *Services ID* (web client id).
APPLE_CLIENT_ID=
# Team id / key id / private key (PKCS#8 PEM) are only needed for the
# authorization-code exchange. Keep the literal \n escapes on one line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Social authentication: Microsoft --------------------------------------
MICROSOFT_CLIENT_ID=
# common (default: personal + organisational) | organizations | consumers | <tenant-id>
MICROSOFT_TENANT_ID=common

# --- Social authentication: Facebook ---------------------------------------
FACEBOOK_APP_ID=
# Server-side only. Never expose this to React/Vite.
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
